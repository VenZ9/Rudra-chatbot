# ---------------------------------------------------------------------------
# Rudra Chatbot — environment variables
# ---------------------------------------------------------------------------
# Copy this file to `.env.local` and fill in your key:
#
#   cp .env.local.example .env.local
#
# The key is read ONLY on the server (app/api/chat/route.ts) and is never
# sent to the browser.
# ---------------------------------------------------------------------------

# Required. Get a free key at https://openrouter.ai/keys
OPENROUTER_API_KEY=your_key_here

# Optional. Any OpenAI-compatible endpoint. Defaults to OpenRouter.
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Optional. Overrides the default model (google/gemma-2-9b-it:free).
# OPENROUTER_MODEL=google/gemma-2-9b-it:free

# Optional. Sent to OpenRouter for attribution/leaderboard ranking.
# OPENROUTER_SITE_URL=https://your-app.vercel.app
# OPENROUTER_SITE_NAME=Rudra Chatbot
